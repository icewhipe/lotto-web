// ============= СИСТЕМА РЕГИСТРАЦИИ =============
// Добавить в schema.prisma после модели User

model InviteCode {
  id          String   @id @default(uuid())
  code        String   @unique
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id])
  
  usedBy      String?  @unique
  usedByUser  User?    @relation(fields: [usedBy], references: [id])
  usedAt      DateTime?
  
  expiresAt   DateTime
  createdBy   String
  creator     User     @relation("InviteCodeCreator", fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  
  isActive    Boolean  @default(true)
  maxUses     Int      @default(1)
  currentUses Int      @default(0)
  
  @@index([code])
  @@index([groupId])
  @@map("invite_codes")
}

model RegistrationRequest {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String
  birthDate   DateTime
  password    String   // Хэшированный
  
  specialtyId String
  specialty   Specialty @relation(fields: [specialtyId], references: [id])
  course      Int
  
  status      RegistrationStatus @default(PENDING)
  
  reviewedBy  String?
  reviewer    User?    @relation(fields: [reviewedBy], references: [id])
  reviewedAt  DateTime?
  rejectReason String?
  
  assignedGroupId String?
  assignedGroup   Group?  @relation(fields: [assignedGroupId], references: [id])
  
  createdUserId String?  @unique
  createdUser   User?    @relation("RegistrationToUser", fields: [createdUserId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([status])
  @@index([email])
  @@map("registration_requests")
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}
