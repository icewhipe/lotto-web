# Database (используй Supabase или Railway для быстрого старта)
DATABASE_URL="postgresql://postgres:password@localhost:5432/lptt_db?schema=public"

# JWT
JWT_SECRET="super-secret-key-change-in-production-123456"
JWT_EXPIRES_IN="7d"

# Redis (опционально, если не установлен - закомментируй)
# REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173"

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Email (настрой для production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Admin Email
ADMIN_EMAIL=admin@lptt.ru

# RFID (для production)
RFID_API_URL="http://rfid-controller.local"
RFID_API_KEY="rfid-api-key"

# Turnstile
TURNSTILE_WEBSOCKET_PORT=3001
TURNSTILE_SECRET="turnstile-secret-123"
